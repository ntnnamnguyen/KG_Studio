# KG Studio - Local Secrets Storage Template (File mẫu cấu hình API Keys)
# Hướng dẫn: Sao chép file này thành config/.secrets.toml hoặc config/secrets.toml
# và điền các API key thực tế của bạn. Tuyệt đối KHÔNG commit file chứa key thực!

[llm_api_keys]
deepseek = "sk-your-deepseek-api-key-here"
openai = "sk-your-openai-api-key-here"
anthropic = "sk-ant-your-anthropic-api-key-here"
qwen = "your-dashscope-api-key-here"


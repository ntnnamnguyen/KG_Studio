# ==============================================================================
# KG Studio - Environment Variables Template
# ==============================================================================
# Hướng dẫn: Sao chép file này thành .env ở thư mục gốc và điền các khóa/cấu hình cần thiết.
# File .env sẽ được .gitignore tự động bỏ qua để tránh rò rỉ thông tin nhạy cảm.

# --- LLM API Keys (Tùy chọn nếu không cấu hình qua config/.secrets.toml) ---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
OPENAI_API_KEY=sk-your-openai-api-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
DASHSCOPE_API_KEY=your-dashscope-api-key-here
QWEN_API_KEY=your-dashscope-api-key-here

# --- Server & Port Settings ---
STREAMLIT_SERVER_PORT=8502
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# --- Neo4j Settings (Nếu sử dụng đồ thị bên ngoài) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password-here

